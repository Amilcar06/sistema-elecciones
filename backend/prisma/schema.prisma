generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario         Int           @id @default(autoincrement())
  email              String        @unique @db.VarChar(255)
  nombre             String        @db.VarChar(100)
  apellido           String        @db.VarChar(100)
  password_hash      String        @db.VarChar(255)
  rol                RolUsuario    @default(USUARIO)
  estado             EstadoUsuario @default(ACTIVO)
  ultimo_acceso      DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  deleted_at         DateTime?
  auditorias         Auditoria[]
  elecciones_creadas Eleccion[]
  sesiones           Sesion[]

  @@index([rol], map: "idx_usuario_rol")
  @@index([estado], map: "idx_usuario_estado")
}

model Sesion {
  id_sesion      Int      @id @default(autoincrement())
  id_usuario     Int
  token          String   @db.Text
  refresh_token  String   @unique @db.Text
  expires_at     DateTime // Sliding expiration (extends with each request)
  absolute_expiry DateTime // Maximum session lifetime (7 days)
  last_activity  DateTime @default(now()) // Last request time for sliding window
  ip_address     String?  @db.VarChar(45)
  user_agent     String?  @db.Text
  created_at     DateTime @default(now())
  usuario        Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@index([token], map: "idx_sesion_token")
  @@index([refresh_token], map: "idx_sesion_refresh_token")
  @@index([id_usuario], map: "idx_sesion_usuario")
}

model Auditoria {
  id_auditoria     Int      @id @default(autoincrement())
  tabla            String   @db.VarChar(50)
  accion           String   @db.VarChar(20)
  id_registro      Int
  datos_anteriores Json?
  datos_nuevos     Json?
  id_usuario       Int?
  ip_address       String?  @db.VarChar(45)
  created_at       DateTime @default(now())
  usuario          Usuario? @relation(fields: [id_usuario], references: [id_usuario])

  @@index([tabla, accion], map: "idx_auditoria_tabla_accion")
  @@index([id_usuario], map: "idx_auditoria_usuario")
}

model Eleccion {
  id_eleccion        Int                    @id @default(autoincrement())
  nombre             String                 @db.VarChar(100)
  fecha              DateTime
  estado             EstadoEleccion         @default(DRAFT)
  descripcion        String?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt
  deleted_at         DateTime?
  id_usuario_creador Int?
  cargos             Cargo[]
  usuario_creador    Usuario?               @relation(fields: [id_usuario_creador], references: [id_usuario])
  publicaciones      PublicacionResultado[]

  @@index([fecha], map: "idx_eleccion_fecha")
  @@index([estado], map: "idx_eleccion_estado")
  @@index([fecha, estado], map: "idx_eleccion_fecha_estado")
  @@index([id_usuario_creador], map: "idx_eleccion_usuario_creador")
}

model CatalogoCargo {
  id_catalogo Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt
  deleted_at  DateTime?
  cargos      Cargo[]
}

model Cargo {
  id_cargo    Int           @id @default(autoincrement())
  id_eleccion Int
  id_catalogo Int
  estado      EstadoCargo   @default(PENDIENTE)
  orden       Int
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  deleted_at  DateTime?
  candidatos  Candidato[]
  catalogo    CatalogoCargo @relation(fields: [id_catalogo], references: [id_catalogo])
  eleccion    Eleccion      @relation(fields: [id_eleccion], references: [id_eleccion])
  rondas      Ronda[]

  @@unique([id_eleccion, orden], name: "uq_eleccion_orden")
  @@index([id_eleccion], map: "idx_cargo_eleccion")
  @@index([estado], map: "idx_cargo_estado")
  @@index([id_catalogo], map: "idx_cargo_catalogo")
}

model Candidato {
  id_candidato    Int         @id @default(autoincrement())
  id_cargo        Int
  nombre_completo String      @db.VarChar(150)
  activo          Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  deleted_at      DateTime?
  cargo           Cargo       @relation(fields: [id_cargo], references: [id_cargo])
  resultados      Resultado[]

  @@unique([id_cargo, nombre_completo], name: "uq_candidato_cargo_nombre")
  @@index([id_cargo], map: "idx_candidato_cargo")
  @@index([activo], map: "idx_candidato_activo")
}

model Ronda {
  id_ronda       Int         @id @default(autoincrement())
  id_cargo       Int
  numero_ronda   Int
  fecha_registro DateTime    @default(now())
  finalizada     Boolean     @default(false)
  observaciones  String?
  deleted_at     DateTime?
  resultados     Resultado[]
  cargo          Cargo       @relation(fields: [id_cargo], references: [id_cargo])

  @@unique([id_cargo, numero_ronda], name: "uq_ronda_cargo_numero")
  @@index([id_cargo], map: "idx_ronda_cargo")
  @@index([fecha_registro], map: "idx_ronda_fecha")
}

model Resultado {
  id_resultado   Int       @id @default(autoincrement())
  id_ronda       Int
  id_candidato   Int
  votos          Int       @default(0)
  registrado_por String?   @db.VarChar(50)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt
  deleted_at     DateTime?
  candidato      Candidato @relation(fields: [id_candidato], references: [id_candidato])
  ronda          Ronda     @relation(fields: [id_ronda], references: [id_ronda])

  @@unique([id_ronda, id_candidato], name: "uq_resultado_ronda_candidato")
  @@index([id_ronda], map: "idx_resultado_ronda")
  @@index([votos], map: "idx_resultado_votos")
  @@index([id_candidato], map: "idx_resultado_candidato")
}

model PublicacionResultado {
  id_publicacion    Int             @id @default(autoincrement())
  id_eleccion       Int
  publicado_por     String?         @db.VarChar(50)
  fecha_publicacion DateTime        @default(now())
  modo              ModoPublicacion @default(PROYECTOR)
  nota              String?
  deleted_at        DateTime?
  eleccion          Eleccion        @relation(fields: [id_eleccion], references: [id_eleccion])

  @@index([id_eleccion], map: "idx_publicacion_eleccion")
}

enum EstadoEleccion {
  DRAFT
  EN_CURSO
  FINALIZADA
}

enum EstadoCargo {
  PENDIENTE
  EN_PROCESO
  FINALIZADO
}

enum ModoPublicacion {
  PROYECTOR
  PDF
  EXCEL
}

enum RolUsuario {
  ADMIN
  USUARIO
  // Mantener roles antiguos para compatibilidad
  ORGANIZADOR
  OBSERVADOR
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}
